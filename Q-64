#include <stdio.h>

int main()
{
    int n, digit, i, count, max = 0, result = 0;
    int temp;

    scanf("%d", &n);

    for(i = 0; i <= 9; i++)
    {
        temp = n;
        count = 0;

        while(temp != 0)
        {
            digit = temp % 10;

            if(digit == i)
                count++;

            temp /= 10;
        }

        if(count > max)
        {
            max = count;
            result = i;
        }
    }

    printf("%d", result);

    return 0;
}
