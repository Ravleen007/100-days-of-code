#include <stdio.h>

int main()
{
    int n, first, last, digits = 1, temp;

    scanf("%d", &n);

    temp = n;

    last = n % 10;

    while(temp >= 10)
    {
        temp = temp / 10;
        digits = digits * 10;
    }

    first = temp;

    n = n - first * digits;
    n = n - last;
    n = n + last * digits;
    n = n + first;

    printf("%d", n);

    return 0;
}
