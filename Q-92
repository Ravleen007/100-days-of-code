// Q92: Find the first repeating lowercase alphabet in a string.

#include <stdio.h>

int main()
{
    char str[100];
    int i, j;

    fgets(str, sizeof(str), stdin);

    for(i = 0; str[i] != '\0'; i++)
    {
        for(j = i + 1; str[j] != '\0'; j++)
        {
            if(str[i] >= 'a' && str[i] <= 'z' && str[i] == str[j])
            {
                printf("%c", str[i]);
                return 0;
            }
        }
    }

    printf("No repeating character");

    return 0;
}
